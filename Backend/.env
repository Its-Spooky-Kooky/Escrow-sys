# Environment Variables for Escrow Backend
# ==========================================

# MongoDB Connection URI
# Option 1 (Atlas Cloud): mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/escrow?retryWrites=true&w=majority
# Option 2 (Local): mongodb://localhost:27017/escrow
MONGO_URI=mongodb+srv://tempmailtm002_db_user:uXIiP9yOOknDik9n@escrowcluster.yg0jlts.mongodb.net/?appName=EscrowCluster

# JWT Secret Key (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=4a003cd2bed32f4a18a04a0a8930d478872f482b74937aa950281ce02ab5233f

# JWT Token Expiration
JWT_EXPIRES_IN=7d

# Server Port
PORT=5000

# Blockchain RPC Provider URL
# Alchemy (Sepolia): https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
# Infura (Sepolia): https://sepolia.infura.io/v3/YOUR_KEY
# Local Hardhat: http://127.0.0.1:8545
RPC_URL=

# Escrow Factory Smart Contract Address (get from your contract developer)
