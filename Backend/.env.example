# Environment Variables for Escrow Backend
# ==========================================

# MongoDB Connection URI (Atlas Cloud or Local)
# Option 1 (Atlas Cloud): mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/escrow?retryWrites=true&w=majority
# Option 2 (Local): mongodb://localhost:27017/escrow
MONGO_URI=your_mongodb_uri_here

# JWT Secret Key for token signing
# (Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your_jwt_secret_here

# JWT Token Expiration
JWT_EXPIRES_IN=7d

# Server Port
PORT=5000

# Blockchain RPC Provider URL (Sepolia, Amoy, or Local Hardhat)
# Alchemy (Sepolia): https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
# Infura (Sepolia): https://sepolia.infura.io/v3/YOUR_KEY
# Local Hardhat: http://127.0.0.1:8545
RPC_URL=

# Escrow Factory Smart Contract Address
ESCROW_FACTORY_ADDRESS=
